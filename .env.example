# ── Flask ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string
FLASK_DEBUG=false

# ── Admin ──────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=change_me_admin_password

# ── Storage (optional — defaults to project root) ──────────────────────────────
# PERSISTENT_DISK_PATH=/data

# ── HTTPS cookie security (set to true behind a reverse proxy with SSL) ────────
HTTPS=false

# ── SMTP (optional — if not set, accounts are activated directly) ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=your@gmail.com
